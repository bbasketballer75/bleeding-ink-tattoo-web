# Resend API key for sending contact form submissions.
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address used in emails sent by Resend.
# For testing, use: onboarding@resend.dev
# For production, use a verified domain address like: Bleeding Ink <hello@bleedinginktattoo.com>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Destination email for contact form submissions.
# Owner has no public email yet (as of 2026-08-17) — use Austin's email as
# placeholder until Isiah sets up a real inbox.
CONTACT_TO_EMAIL=austin@example.com

# GlossGenius widget URL for /book page embed.
# Get from GlossGenius dashboard → Online Booking → Share → Embed URL
NEXT_PUBLIC_GLOSSGENIUS_URL=https://app.glossgenius.com/booking/your-studio-slug

# Optional: Plausible analytics domain
# Get yours at: https://plausible.io/
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bleedinginktattoo.com