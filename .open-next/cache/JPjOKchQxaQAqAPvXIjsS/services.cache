tps://schema.org\",\"@type\":[\"TattooParlor\",\"LocalBusiness\"],\"@id\":\"https://bleedinginktattoo.com#business\",\"name\":\"Bleeding Ink Tattooing\",\"alternateName\":\"Bleeding Ink\",\"description\":\"Custom tattoo studio in Johnstown, PA. Coverups, color work, walk-ins welcome. Located in the Johnstown Galleria. Free consultation, $65 deposit.\",\"url\":\"https://bleedinginktattoo.com\",\"telephone\":\"(215) 980-1386\",\"image\":\"https://bleedinginktattoo.com/og-default.svg\",\"logo\":\"https://bleedinginktattoo.com/icons/logo.png\",\"priceRange\":\"$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"500 Galleria Dr\",\"addressLocality\":\"Johnstown\",\"addressRegion\":\"PA\",\"postalCode\":\"15904\",\"addressCountry\":\"US\"},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Tuesday\",\"opens\":\"11:00\",\"closes\":\"19:00\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Wednesday\",\"opens\":\"11:00\",\"closes\":\"19:00\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Thursday\",\"opens\":\"11:00\",\"closes\":\"19:00\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Friday\",\"opens\":\"11:00\",\"closes\":\"19:00\"},{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":\"Saturday\",\"opens\":\"11:00\",\"closes\":\"19:00\"}],\"sameAs\":[\"https://www.facebook.com/BleedingInkTattooing/\",\"https://www.instagram.com/ibleedink_600/\",\"https://www.threads.net/@ibleedink_600\"],\"founder\":{\"@type\":\"Person\",\"name\":\"Isiah Jackson\"}}</script><a href=\"#main\" class=\"skip-link\">Skip to content</a><header style=\"position:fixed;top:0;left:0;right:0;z-index:50;background:transparent;transition:background 0.2s ease;border-bottom:none\"><nav style=\"max-width:1280px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px\" aria-label=\"Main\"><a style=\"font-family:var(--font-display);font-size:28px;font-weight:400;letter-spacing:-0.02em;color:#F5F1E8;text-decoration:none;text-transform:uppercase;white-space:nowrap\" href=\"/\">Bleeding <span style=\"color:#8B0000\">Ink</span></a><div class=\"desktop-nav\" style=\"display:flex;align-items:center;gap:28px\"><a class=\"nav-link\" style=\"opacity:0.85;border-bottom:2px solid transparent;padding-bottom:4px\" href=\"/artists\">Artists</a><a class=\"nav-link\" style=\"opacity:0.85;border-bottom:2px solid transparent;padding-bottom:4px\" href=\"/portfolio\">Portfolio</a><a class=\"nav-link\" style=\"opacity:1;border-bottom:2px solid #8B0000;padding-bottom:4px\" href=\"/services\">Services</a><a class=\"nav-link\" style=\"opacity:0.85;border-bottom:2px solid transparent;padding-bottom:4px\" href=\"/faq\">FAQ</a><a class=\"nav-link\" style=\"opacity:0.85;border-bottom:2px solid transparent;padding-bottom:4px\" href=\"/contact\">Contact</a><a class=\"nav-link\" style=\"opacity:0.85;border-bottom:2px solid transparent;padding-bottom:4px\" href=\"/book\">Book</a></div><a href=\"tel:+12159801386\" class=\"desktop-cta\" style=\"display:flex;align-items:center;gap:8px;padding:10px 18px;background:#8B0000;color:#F5F1E8;text-decoration:none;font-weight:700;font-size:14px;letter-spacing:0.02em;text-transform:uppercase;border:2px solid #8B0000;transition:background 0.15s ease, color 0.15s ease\" aria-label=\"Call Bleeding Ink\"><span aria-hidden=\"true\">📞</span><span>(215) 980-1386</span></a><button type=\"button\" class=\"mobile-menu-btn\" aria-label=\"Open menu\" aria-expanded=\"false\" style=\"display:none;align-items:center;justify-content:center;width:44px;height:44px;background:transparent;border:2px solid #F5F1E8;color:#F5F1E8;cursor:pointer;padding:0\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button></nav></header><main id=\"main\" style=\"min-height:60vh\"><section style=\"position:relative;min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;color:#F5F1E8;background:radial-gradient(ellipse at top, rgba(139, 0, 0, 0.18) 0%, #0A0A0A 70%);background-size:cover;background-position:center;padding:120px 24px 60px;overflow:hidden\"><div style=\"max-width:980px;width:100%\"><h1 style=\"font-family:var(--font-display);font-size:clamp(40px, 8vw, 80px);text-transform:uppercase;letter-spacing:-0.03em;line-height:0.92;margin:0;color:#F5F1E8\"><span>Services</span></h1><p style=\"font-family:var(--font-marker);font-size:20px;margin-top:20px;margin-bottom:28px;opacity:0.9;letter-spacing:0.01em;max-width:640px;margin-left:auto;margin-right:auto\">Custom work, coverups, color. Every piece starts with a free conversation.</p></div></section><section style=\"padding:60px 24px 40px\"><div style=\"max-width:1280px;margin:0 auto\"><div style=\"text-align:left;margin-bottom:48px;max-width:960px\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#8B0000;margin-bottom:12px\">What We Do</div><h2 style=\"font-family:var(--font-display);font-size:clamp(36px, 6vw, 64px);line-height:0.95;letter-spacing:-0.02em;text-transform:uppercase;margin:0\">4 core services</h2><p style=\"font-size:17px;line-height:1.6;margin-top:20px;opacity:0.85\">From coverups to color work, we do it all. Bring a photo, a description, or a feeling — we&#x27;ll work it out together.</p></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:24px\"><div style=\"background:var(--color-bone-white);color:var(--color-ink-black);padding:32px;display:flex;flex-direction:column;gap:16px;border:1px solid rgba(10, 10, 10, 0.08)\"><h3 style=\"font-family:var(--font-display);font-size:28px;text-transform:uppercase;letter-spacing:-0.01em;margin:0;line-height:1\">Custom Tattoos</h3><p style=\"font-size:15px;line-height:1.6;margin:0;opacity:0.85\">Every custom tattoo starts with a free consultation. We&#x27;ll talk through placement, size, style, and budget, then sketch and refine before any ink goes down. Most custom work needs 2-4 hours per session.</p><div style=\"margin-top:auto\"><a style=\"font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#8B0000;text-decoration:none\" href=\"/contact\">Get a quote →</a></div></div><div style=\"background:var(--color-bone-white);color:var(--color-ink-black);padding:32px;display:flex;flex-direction:column;gap:16px;border:1px solid rgba(10, 10, 10, 0.08)\"><h3 style=\"font-family:var(--font-display);font-size:28px;text-transform:uppercase;letter-spacing:-0.01em;margin:0;line-height:1\">Coverups</h3><p style=\"font-size:15px;line-height:1.6;margin:0;opacity:0.85\">Coverups require a careful eye — color, density, and placement all matter. Some coverups can be done in one session; others need a laser pre-treatment to lighten the old ink first. Consultation is free; we&#x27;ll tell you upfront what&#x27;s realistic.</p><div style=\"margin-top:auto\"><a style=\"font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#8B0000;text-decoration:none\" href=\"/contact\">Get a quote →</a></div></div><div style=\"background:var(--color-bone-white);color:var(--color-ink-black);padding:32px;display:flex;flex-direction:column;gap:16px;border:1px solid rgba(10, 10, 10, 0.08)\"><h3 style=\"font-family:var(--font-display);font-size:28px;text-transform:uppercase;letter-spacing:-0.01em;margin:0;line-height:1\">Color Work</h3><p style=\"font-size:15px;line-height:1.6;margin:0;opacity:0.85\">Saturated, long-lasting color. We work in a range of palettes — saturated full-color pieces, soft pastels, traditional Americana — whatever fits the design.</p><div style=\"margin-top:auto\"><a style=\"font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#8B0000;text-decoration:none\" href=\"/contact\">Get a quote →</a></div></div><div style=\"background:var(--color-bone-white);color:var(--color-ink-black);padding:32px;display:flex;flex-direction:column;gap:16px;border:1px solid rgba(10, 10, 10, 0.08)\"><h3 style=\"font-family:var(--font-display);font-size:28px;text-transform:uppercase;letter-spacing:-0.01em;margin:0;line-height:1\">Free Consultations</h3><p style=\"font-size:15px;line-height:1.6;margin:0;opacity:0.85\">Walk-ins welcome for consultations. No appointment needed. We&#x27;ll look at placement, size, style, and budget, and give you a realistic timeline and quote. Deposits are $65 (non-refundable) when you&#x27;re ready to book a session.</p><div style=\"margin-top:auto\"><a style=\"font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:#8B0000;text-decoration:none\" href=\"/contact\">Get a quote →</a></div></div></div></div></section><section style=\"background:var(--color-bone-white);color:var(--color-ink-black);padding:60px 24px\"><div style=\"max-width:960px;margin:0 auto\"><div style=\"text-align:left;margin-bottom:48px;max-width:960px\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#8B0000;margin-bottom:12px\">Pricing</div><h2 style=\"font-family:var(--font-display);font-size:clamp(36px, 6vw, 64px);line-height:0.95;letter-spacing:-0.02em;text-transform:uppercase;margin:0\">DM for quote · ${formatUSD(DEPOSIT_MIN)} to book</h2><p style=\"font-size:17px;line-height:1.6;margin-top:20px;opacity:0.85\">Every piece is different. Hourly rates depend on size, detail, placement, and style — we&#x27;ll give you a realistic quote at the consultation. The deposit is the only number we publish, and it&#x27;s non-refundable.</p></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:24px;margin-top:32px\"><div style=\"padding:24px;border:2px solid #8B0000\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#8B0000;margin-bottom:8px\">Deposit</div><div style=\"font-family:var(--font-display);font-size:40px;line-height:1\">$65</div><div style=\"font-size:13px;opacity:0.85;margin-top:8px\">Non-refundable. Comes off your final tattoo price.</div></div><div style=\"padding:24px;border:2px solid rgba(10, 10, 10, 0.15)\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px\">Consultation</div><div style=\"font-family:var(--font-display);font-size:40px;line-height:1\">Free</div><div style=\"font-size:13px;opacity:0.85;margin-top:8px\">Walk in or book ahead. No obligation.</div></div><div style=\"padding:24px;border:2px solid rgba(10, 10, 10, 0.15)\"><div style=\"font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:8px\">Hourly Rate</div><div style=\"font-family:var(--font-display);font-size:32px;line-height:1.1\">By quote</div><div style=\"font-size:13px;opacity:0.85;margin-top:8px\">Depends on the piece. We&#x27;ll tell you upfront.</div></div></div></div></section><section style=\"padding:60px 24px;text-align:center\"><div style=\"max-width:720px;margin:0 auto\"><p style=\"font-size:18px;opacity:0.85;margin:0;margin-bottom:24px\">Ready to talk about your piece? Free consultation, no obligation.</p><div style=\"display:flex;flex-wrap:wrap;gap:16px;justify-content:center\"><a class=\"btn-primary\" style=\"font-size:14px\" href=\"/book\">Book a Session</a><a class=\"btn-secondary\" style=\"font-size:14px\" href=\"/contact\">Send a Message</a></div></div></section><!--$--><!--/$--></main><footer style=\"background:#0A0A0A;color:#F5F1E8;margin-top:80px\"><div style=\"max-width:1280px;margin:0 auto;padding:60px 24px 24px\"><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:48px;padding-bottom:48px;border-bottom:1px solid rgba(245, 241, 232, 0.15)\"><div><h3 style=\"font-family:var(--font-display);font-size:24px;text-transform:uppercase;marg